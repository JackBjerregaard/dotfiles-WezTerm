#!/usr/bin/env bash

source "$HOME/.config/sketchybar/variables.sh" # Loads all defined colors

# General bar and defaults

sketchybar --bar height=30 \
	color="$BAR_COLOR" \
	shadow="$SHADOW" \
	position=top \
	topmost=window \
	sticky=on \
	padding_right=0 \
	padding_left=12 \
	corner_radius="$CORNER_RADIUS" \
	y_offset=5 \
	margin=5 \
	blur_radius=20 \
	notch_width=200 \
	--default updates=when_shown \
	icon.font="$FONT:Bold:13.5" \
	icon.color="$ICON_COLOR" \
	icon.padding_left="$PADDINGS" \
	icon.padding_right="$PADDINGS" \
	label.font="$FONT:Bold:13.0" \
	label.color="$LABEL_COLOR" \
	label.padding_left="$PADDINGS" \
	label.padding_right="$PADDINGS" \
	background.padding_right="$PADDINGS" \
	background.padding_left="$PADDINGS" \
	popup.background.border_width=1 \
	popup.background.corner_radius=11 \
	popup.background.border_color="$POPUP_BORDER_COLOR" \
	popup.background.color="$POPUP_BACKGROUND_COLOR" \
	popup.background.shadow.drawing="$SHADOW"

# Custom events
#
# SketchyBar only delivers a custom event to items that subscribed to it *after*
# it was registered, so these must be declared before any item is sourced.
#
# - aerospace_workspace_change: raised by exec-on-workspace-change in
#   aerospace.toml, carrying FOCUSED_WORKSPACE. Drives the workspace indicators,
#   which can no longer use SketchyBar's built-in macOS Spaces events because
#   AeroSpace workspaces are not macOS Spaces.
# - window_focus: raised by on-focus-changed in aerospace.toml. Previously
#   triggered by yabai signals, but never actually registered here — so the
#   window-title item only ever refreshed on front_app_switched.
sketchybar --add event aerospace_workspace_change
sketchybar --add event window_focus

# Left
# source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/front_app.sh"
source "$ITEM_DIR/window_title.sh"

# Right (sourced right-to-left: first = rightmost)
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/weather.sh"
source "$ITEM_DIR/dnd.sh"

#################### Finalizing Setup ####################

sketchybar --hotload true

sketchybar --update

echo "sketchybar configuration loaded.."

pkill -x sketchybar-toggle; sketchybar-toggle &
