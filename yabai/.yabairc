#!/usr/bin/env bash

# Load the scripting addition when SIP and sudoers are configured. The -n flag
# prevents startup from hanging if sudoers is not ready yet.
yabai -m signal --add event=dock_did_restart action="sudo -n yabai --load-sa"
sudo -n yabai --load-sa

yabai -m signal --add event=window_focused action="sketchybar --trigger window_focus"
yabai -m signal --add event=window_title_changed action="sketchybar --trigger window_focus"

focus_window_script="$HOME/dotfiles/scripts/yabai-focus-current-space-window.sh"
yabai -m signal --add event=window_destroyed action="$focus_window_script"
yabai -m signal --add event=window_minimized action="$focus_window_script"
yabai -m signal --add event=application_terminated action="$focus_window_script"
yabai -m signal --add event=space_changed action="$focus_window_script"
yabai -m signal --add event=display_changed action="$focus_window_script"

yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config window_insertion_point focused
yabai -m config split_ratio 0.50
yabai -m config split_type auto
yabai -m config auto_balance off

# Existing spaces can keep a floating layout across reloads; bring them back
# under bsp so newly opened windows are tiled consistently.
yabai -m query --spaces | jq -r '.[] | select(."is-native-fullscreen" == false) | .index' | while read -r space; do
  yabai -m space "$space" --layout bsp
done

# Keep windows near the SketchyBar, with a little more side and bottom breathing room.
yabai -m config top_padding 10
yabai -m config bottom_padding 8
yabai -m config left_padding 8
yabai -m config right_padding 8
yabai -m config window_gap 8

yabai -m config mouse_follows_focus on
yabai -m config focus_follows_mouse off
yabai -m config mouse_modifier ctrl
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

yabai -m config window_shadow off
yabai -m config window_opacity on
yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 0.90
yabai -m config window_opacity_duration 0.0
yabai -m config window_animation_duration 0.25
yabai -m config window_animation_easing ease_out_quint
yabai -m config skip_window_focus_animation on

# Keep common utility windows floating.
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^1Password$" manage=off
yabai -m rule --add app="^Preview$" manage=off
yabai -m rule --add app="^QuickTime Player$" manage=off
yabai -m rule --add app="^Disk Utility$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off

# SketchyBar occupies the top edge; top_padding above keeps tiled windows clear.
# yabai -m config external_bar all:40:0

echo "yabai configuration loaded"
